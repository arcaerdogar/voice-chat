{
  "name": "riftvoice",
  "version": "1.0.0",
  "description": "Oyun için hafif, çökmeyen web tabanlı sesli sohbet (WebRTC P2P + WebSocket sinyal sunucusu)",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "test:server": "node --test test/server.test.js",
    "test:e2e": "node --test test/e2e.test.js",
    "test:turn": "node --test test/turn.test.js",
    "test:music": "node --test test/music.test.js",
    "test:noise": "node --test test/noise.test.js",
    "test:sources": "node --test test/sources.test.js",
    "test:stream": "node --test test/stream.test.js",
    "test:screen": "node --test test/screen.test.js",
    "test:camera": "node --test test/camera.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "playwright": "^1.64.0"
  }
}
