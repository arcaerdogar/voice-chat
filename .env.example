# Sunucuda: cp .env.example .env  ve değerleri doldur.
# TURN_SECRET üretmek için: openssl rand -hex 32
TURN_SECRET=buraya-uzun-rastgele-bir-deger-yaz

# İsteğe bağlı: YouTube Data API v3 anahtarı (bkz. deploy/DEPLOY.md, "Müzik: YouTube API anahtarı").
# Şarkı adıyla aramayı ve çalınamayan videolar için otomatik alternatif bulmayı açar.
YOUTUBE_API_KEY=
# Bölge engeli kontrolü ve arama için ülke kodu
MUSIC_REGION=TR
